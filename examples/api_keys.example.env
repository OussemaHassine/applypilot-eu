# ApplyPilot configuration
# Scoring, tailoring and cover letters need ONE LLM provider. Fill in a key, then: applypilot doctor

# Option A (recommended, free tier): https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# LLM_MODEL=gemini-2.5-flash
# If you hit free-tier rate limits, try: LLM_MODEL=gemini-2.5-flash-lite

# Option B: OpenAI (comment out the Gemini lines above)
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna

# Optional: CAPTCHA solving during auto-apply
# CAPSOLVER_API_KEY=

# Gmail response tracker (applypilot inbox). Create an app password at https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=
