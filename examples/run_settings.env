# ApplyPilot run settings (read by daily_run.sh). Edit freely.
MIN_SCORE=7          # only tailor/apply to jobs scored at least this (1-10)
MAX_APPLY=60         # max applications per round
WORKERS=2            # parallel browser windows during apply
APPLY_MODEL=sonnet   # Claude model driving the browser: sonnet (reliable) or haiku (cheaper, weaker)
HEADLESS=0           # 1 = browsers without a window (servers / containers)
